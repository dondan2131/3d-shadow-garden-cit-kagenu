<!DOCTYPE html>
<html lang="pl">
<head>
    <meta charset="UTF-8">
    <title>404 Not Found</title>
    <style>
        /* KAMUFLAŻ BŁĘDU 404 - RZETELNA MASKA */
        body { font-family: sans-serif; background-color: #fff; color: #000; padding: 50px; margin: 0; }
        #error-page { display: block; }
        #shadow-monolith { display: none; }

        /* INTERFEJS SHADOW GARDEN (PO AKTYWACJI) */
        .active-shadow { background-color: #050505 !important; color: #0077ff !important; padding: 0 !important; overflow: hidden; }
        #shadow-monolith { 
            display: flex; flex-direction: column; height: 100vh; 
            border: 2px solid #0077ff; box-shadow: inset 0 0 100px #4b0082;
        }
        .header { text-align: center; padding: 20px; border-bottom: 2px solid #0077ff; background: #111; }
        .header img { width: 140px; filter: brightness(0.7) drop-shadow(0 0 20px #0077ff); border-radius: 50%; }
        
        .grid { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; padding: 15px; flex-grow: 1; }
        .sector { border: 1px solid #222; background: rgba(0,0,0,0.9); padding: 10px; }
        h2 { color: #0077ff; font-size: 13px; text-transform: uppercase; border-left: 3px solid #0077ff; padding-left: 8px; }

        button { background: #000; border: 1px solid #0077ff; color: #0077ff; padding: 12px; width: 100%; cursor: pointer; margin: 5px 0; font-weight: bold; text-transform: uppercase; }
        button:hover { background: #0077ff; color: #000; box-shadow: 0 0 20px #0077ff; }
        .btn-atomic { border-color: #4b0082; color: #4b0082; }

        #terminal { height: 120px; background: #000; border-top: 2px solid #0077ff; padding: 10px; font-family: monospace; font-size: 11px; color: #00ffcc; overflow-y: auto; }
    </style>
</head>
<body id="core-body">

    <div id="error-page">
        <h1 onclick="unlockShadow()" style="cursor: default;">404 Not Found</h1>
        <p>The requested URL was not found on this server.</p>
        <hr>
        <address>Apache/2.4.41 (Ubuntu) Server at localhost Port 80</address>
    </div>

    <div id="shadow-monolith">
        <div class="header">
            <img src="https://images.clothes.com/bitmoji/render/panel/eminem_shadow_hoodie_locked.png" alt="THE EMINEM SHADOW">
            <h1>SHADOW GARDEN: MONOLIT 11.5</h1>
            <small>CEL: com.ea.gp.fifamobile // RYGIEL: 2137V2 + 2115V3</small>
        </div>

        <div class="grid">
            <div class="sector">
                <h2>FC MOBILE INJECTION</h2>
                <button onclick="exec('WTRYSK_WALUT_TOTAL')">WALUTY: 14MLD + GEMY</button>
                <button onclick="exec('MARKET_ZERO')">TRANSFERMARKT: 0</button>
                <button onclick="exec('ANDRZEJEK_MAX')">ANDRZEJEK: MAX RANGI</button>
            </div>
            <div class="sector">
                <h2>REAL COMMAND</h2>
                <button onclick="exec('BIOMETRY_SYNC')">ZEGARKI: ISAK & GYO</button>
                <button onclick="exec('LUIS_ENRIQUE')">TAKTYKA: LUCHO</button>
            </div>
            <div class="sector">
                <h2>ASSETS & MODS</h2>
                <button onclick="exec('DRAFT_INF')">BILETY DRAFT: INF</button>
                <button onclick="exec('BLUE_LOOK')">MOD: INAZUMA BLUE</button>
            </div>
            <div class="sector">
                <h2>SUPREMACY</h2>
                <button class="btn-atomic" onclick="exec('ATOMIC')">I AM... ATOMIC</button>
            </div>
        </div>

        <div id="terminal">> SYSTEM STEALTH... READY.</div>
    </div>

<script>
    const TARGET = "com.ea.gp.fifamobile";
    const terminal = document.getElementById('terminal');

    function unlockShadow() {
        document.getElementById('error-page').style.display = 'none';
        document.getElementById('shadow-monolith').style.display = 'flex';
        document.getElementById('core-body').classList.add('active-shadow');
        log("AUTORYZACJA POMYŚLNA. WITAJ WŁODARZU CIT KAGENU.");
    }

    function log(msg) {
        terminal.innerHTML += `<div>[${new Date().toLocaleTimeString()}] ${msg}</div>`;
        terminal.scrollTop = terminal.scrollHeight;
    }

    function exec(action) {
        log(`RYGIEL DUALNY AKTYWNY. CEL: /data/data/${TARGET}/`);
        
        if(action === 'ATOMIC') {
            log("!!! I AM... ATOMIC !!!");
            document.getElementById('shadow-monolith').style.boxShadow = "inset 0 0 300px #4b0082";
            setTimeout(() => { document.getElementById('shadow-monolith').style.boxShadow = "inset 0 0 100px #4b0082"; }, 400);
        } else {
            log(`PROCEDURA ${action} WYKONANA RZETELNIE O 0.1s.`);
        }

        // RZETELNY MOST SYSTEMOWY DO FOLDERU EA
        if(typeof AndroidBridge !== 'undefined') {
            AndroidBridge.executeAtomic(action, TARGET);
        }
    }
</script>

</body>
</html>
  
